---
import Icon from "./Icon.astro";
const { t, lang = "es", active = "home", esHref = "/", enHref = "/en/" } = Astro.props;
const base = lang === "es" ? "" : "/en";
const home = base + "/";
const items = [
  { id: "about", label: t.nav.about, href: base + (lang === "es" ? "/sobre-mi" : "/about") },
  { id: "work", label: t.nav.work, href: home + "#work" },
  { id: "expertise", label: t.nav.expertise, href: home + "#expertise" },
  { id: "blog", label: t.nav.blog, href: base + "/blog" },
];
const isActive = (id) => (id === "about" && active === "about") || (id === "blog" && active === "blog");
---
<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href={home}>
      <span class="nav__brand-mark">FR</span>
      <span class="nav__brand-name">Facundo Ruiz</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {items.map((it) => (
        <a class={"nav__link" + (isActive(it.id) ? " is-active" : "")} href={it.href}>{it.label}</a>
      ))}
    </nav>

    <div class="nav__tools">
      <div class="lang-switch" role="group" aria-label="Language">
        <a class={lang === "es" ? "on" : ""} href={esHref}>ES</a>
        <span class="lang-sep">/</span>
        <a class={lang === "en" ? "on" : ""} href={enHref}>EN</a>
      </div>
      <button class="icon-btn theme-toggle" data-theme-toggle aria-label={t.theme.dark} title={t.theme.dark}>
        <Icon name="moon" size={18} />
        <Icon name="sun" size={18} />
      </button>
      <button class="burger" data-burger aria-label="Menu" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" data-mobile>
    {items.map((it) => (
      <a class="nav__mobile-link" href={it.href}><span>{it.label}</span><Icon name="arrow-ur" size={15} /></a>
    ))}
  </div>
</header>
