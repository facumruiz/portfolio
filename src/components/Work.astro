---
import Icon from "./Icon.astro";
import { PROJECTS, POSTS } from "../data/content.js";
const { t, lang = "es" } = Astro.props;
const base = lang === "es" ? "" : "/en";
const postFor = (pid) => POSTS.find((po) => po.projectId === pid);
---
<section id="work" class="section">
  <div class="wrap">
    <div class="sec-head">
      <span class="sec-index">{t.work.index}</span>
      <div class="sec-head-text">
        <h2 class="sec-title">{t.work.title}</h2>
        <p class="sec-sub">{t.work.sub}</p>
      </div>
    </div>

    <ol class="work-list">
      {PROJECTS.map((p, i) => {
        const c = p[lang];
        const post = postFor(p.id);
        const href = post ? base + "/blog/" + post.slug : base + "/blog";
        return (
          <li class="work-item reveal" style={`--reveal-delay:${i * 60}ms`}>
            <a class="work-item__btn" href={href}>
              <div class="work-item__media">
                {p.diagram ? (
                  <div class="ehimg">
                    <img class="ehimg__img" src={p.diagram} alt={c.title} loading="lazy" draggable="false" />
                    <span class="ehimg__sweep" aria-hidden="true"></span>
                    <span class="hovid__hint ehimg__hint mono-label"><span class="hovid__play" aria-hidden="true">▶</span> demo</span>
                  </div>
                ) : p.shots ? (
                  <div class="pmshot pmshot--hover" data-pmshot>
                    {p.shots.map((src, si) => (
                      <img class={"pmshot__img" + (si === 0 ? " is-on" : "")} src={src} alt={c.title} loading="lazy" draggable="false" />
                    ))}
                    <span class="pmshot__scrim" aria-hidden="true"></span>
                    <span class="pmshot__dots" aria-hidden="true">
                      {p.shots.map((_, si) => <span class={"pmshot__dot" + (si === 0 ? " is-on" : "")}></span>)}
                    </span>
                    <span class="hovid__hint pmshot__hint mono-label"><span class="hovid__play" aria-hidden="true">▶</span> demo</span>
                  </div>
                ) : p.media ? (
                  <div class="hovid" data-hovid>
                    <img class="hovid__poster" src={p.media.poster} alt={c.title} loading="lazy" draggable="false" />
                    <video class="hovid__video" src={p.media.video} muted loop playsinline preload="none"></video>
                    <span class="hovid__hint mono-label"><span class="hovid__play" aria-hidden="true">▶</span> demo</span>
                  </div>
                ) : (
                  <div class="work-item__placeholder" aria-hidden="true"></div>
                )}
              </div>
              <div class="work-item__body">
                <div class="work-item__top">
                  <span class="mono-label">{c.role}</span>
                  <span class="mono-label work-item__year">{p.year}</span>
                </div>
                <h3 class="work-item__title">{c.title}</h3>
                <p class="work-item__tag">{c.tagline}</p>
                <p class="work-item__outcome">{c.outcome}</p>
                <div class="work-item__stack">
                  {p.stack.map((s) => <span class="tag">{s}</span>)}
                </div>
                <span class="arrow-link work-item__link">{t.work.view} <Icon name="arrow" size={15} /></span>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<script>
  function initPmShots() {
    document.querySelectorAll("[data-pmshot]").forEach((box) => {
      if (box.dataset.bound) return;
      box.dataset.bound = "1";
      const imgs = box.querySelectorAll(".pmshot__img");
      const dots = box.querySelectorAll(".pmshot__dot");
      if (imgs.length < 2) return;
      let idx = 0, timer = null;
      const show = (n) => {
        imgs.forEach((im, k) => im.classList.toggle("is-on", k === n));
        dots.forEach((d, k) => d.classList.toggle("is-on", k === n));
      };
      const tick = () => { idx = (idx + 1) % imgs.length; show(idx); };
      const start = () => { if (!timer) timer = setInterval(tick, 1600); box.classList.add("is-playing"); };
      const stop = () => { clearInterval(timer); timer = null; idx = 0; show(0); box.classList.remove("is-playing"); };
      const auto = box.classList.contains("pmshot--auto");
      if (auto) { start(); }
      else {
        box.addEventListener("mouseenter", start);
        box.addEventListener("mouseleave", stop);
      }
    });
  }
  document.addEventListener("astro:page-load", initPmShots);
  document.addEventListener("DOMContentLoaded", initPmShots);
</script>
