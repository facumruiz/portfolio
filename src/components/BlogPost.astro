---
import Icon from "./Icon.astro";
import { PROJECTS } from "../data/content.js";
const { t, lang = "es", post } = Astro.props;
const base = lang === "es" ? "" : "/en";
const c = post[lang];
const project = PROJECTS.find((p) => p.id === post.projectId);
const fmt = (iso) => new Date(iso + "T00:00:00").toLocaleDateString(lang === "es" ? "es-AR" : "en-US", { year: "numeric", month: "short", day: "numeric" });
---
<main class="post-page">
  <article class="section">
    <div class="wrap wrap--reading">
      <a class="arrow-link post-back" href={base + "/blog"}><Icon name="back" size={15} /> {t.blog.back}</a>

      <div class="post-page__meta">
        <span class="post-row__date mono-label">{fmt(post.date)}</span>
        <span class="mono-label">·</span>
        <span class="mono-label">{post.readMin} {t.blog.readTime}</span>
      </div>
      <h1 class="post-page__title">{c.title}</h1>
      <p class="post-page__excerpt">{c.excerpt}</p>
      <div class="post-page__tags">
        {post.tags.map((tg) => <span class="tag">{tg}</span>)}
      </div>

      {post.repo && (
        <a class="arrow-link post-page__repo" href={post.repo} target="_blank" rel="noopener"><Icon name="github" size={15} /> {post.repo.replace("https://github.com/", "")} <Icon name="arrow-ur" size={13} /></a>
      )}

      {post.youtube ? (
        <div class="post-page__hero">
          <div class="post-video" data-yt={post.youtube}>
            <button class="post-video__poster" type="button" aria-label={(lang === "es" ? "Reproducir video · " : "Play video · ") + c.title}>
              <img src={post.poster} alt={c.title} draggable="false" />
              <span class="post-video__scrim" aria-hidden="true"></span>
              <span class="post-video__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="32" height="32"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
              </span>
              <span class="post-video__cta mono-label">{lang === "es" ? "Ver demo" : "Watch demo"}</span>
            </button>
          </div>
        </div>
      ) : project && project.media && (
        <div class="post-page__hero">
          <img src={project.media.poster} alt={c.title} loading="lazy" />
        </div>
      )}

      <div class="prose">
        {c.body.map((b) => {
          if (b.type === "h") return <h2 class="prose__h">{b.text}</h2>;
          if (b.type === "code") return <pre class="prose__code"><code>{b.text}</code></pre>;
          return <p class="prose__p">{b.text}</p>;
        })}
      </div>

      {project && (
        <div class="post-page__project">
          <span class="mono-label">{t.work.stack}</span>
          <div class="post-card__tags">
            {project.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
        </div>
      )}

      <div class="post-page__foot">
        <a class="btn btn--ghost" href={base + "/blog"}><Icon name="back" size={15} /> {t.blog.back}</a>
      </div>
    </div>
  </article>
</main>

<script>
  function initPostVideo() {
    document.querySelectorAll(".post-video[data-yt]").forEach((box) => {
      const poster = box.querySelector(".post-video__poster");
      if (!poster || box.dataset.bound) return;
      box.dataset.bound = "1";
      poster.addEventListener("click", () => {
        const id = box.getAttribute("data-yt");
        const iframe = document.createElement("iframe");
        iframe.className = "post-video__frame";
        iframe.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1&rel=0";
        iframe.title = poster.querySelector("img")?.alt || "video";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        box.innerHTML = "";
        box.appendChild(iframe);
      });
    });
  }
  document.addEventListener("astro:page-load", initPostVideo);
  document.addEventListener("DOMContentLoaded", initPostVideo);
</script>
