---
import { STRINGS } from "../data/content.js";
import BaseLayout from "../components/BaseLayout.astro";
import AboutContent from "../components/AboutContent.astro";
const lang = "es";
const t = STRINGS[lang];
---
<BaseLayout t={t} lang={lang} title="Sobre mí — Facundo Ruiz" description={t.about.pageSub} active="about" esHref="/sobre-mi" enHref="/en/about">
  <AboutContent t={t} lang={lang} />
</BaseLayout>
